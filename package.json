{
  "name": "productivity-mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "lint": "expo lint --no-cache",
    "typecheck": "tsc --noEmit",
    "test": "jest --watchAll=false",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-native-picker/picker": "2.11.4",
    "@supabase/supabase-js": "^2.56.0",
    "@tanstack/react-query": "^5.85.5",
    "expo": "^55.0.19",
    "expo-asset": "^55.0.16",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "^55.0.15",
    "expo-dev-client": "^55.0.30",
    "expo-device": "^55.0.15",
    "expo-font": "~55.0.06",
    "expo-linking": "^55.0.14",
    "expo-location": "~55.1.8",
    "expo-media-library": "~55.0.15",
    "expo-notifications": "^55.0.22",
    "expo-router": "^55.0.13",
    "expo-splash-screen": "^55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-task-manager": "^55.0.15",
    "expo-web-browser": "~55.0.20",
    "openai": "^6.9.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-background-fetch": "^4.3.0",
    "react-native-device-info": "^15.0.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-google-mobile-ads": "^15.8.3",
    "react-native-purchases": "^9.14.0",
    "react-native-purchases-ui": "^9.14.0",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.1.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.4",
    "react-test-renderer": "^19.2.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
